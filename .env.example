# Profiles - enable services if needed
# proxy: enabled Caddy as an https terminator and proxy
# search: enable Apache Solr for searching on the FSI Server
# mirror: enable lsyncd if you have a mirror server and want to synchronise source images

COMPOSE_PROFILES="proxy,search"

# Add you public domain(s) here: fsi-images.domain.tld
# Use comma to separate multiple domains
# Caddy automatically gets and manages SSL certificates.
#
SERVER_DOMAINS=localhost

#
# SERVER_TLS_CONFIG=tls_config.conf

#
# FSI Server container repository image and version
#
FSI_SERVER_IMAGE_NAME=neptunelabs/fsi-server
FSI_SERVER_IMAGE_TAG=24.07

# Paths for FSI Server configurations
FSI_CONFIG_PATH=./conf/fsi-server

# Base path for all connector source images
CONNECTOR_PATH=./connectors

# Path for the FSI Server storage
STORAGE_PATH=./fsi-data/storage

# Path for FSI Viewer settings and skins
OVERLAY_PATH=./fsi-data/overlay

# Path for logging files
LOG_PATH=./fsi-data/logs

# Verbosity of FSI Server logging
LOG_FSI_LEVEL=info

# Leave untouched if you haven't an external Apache Solr server
SOLR_SERVER_URI=http://solr-10:8983/solr/

#
# Memory limits for Java services
#
FSI_MEM_LIMIT=4G
SOLR_MEM_LIMIT=2G

#
# This is for mirror servers only:
# profile "mirror" (see above) required
#

# Hostname and SSH port of the mirror server
MIRROR_HOSTNAME=fsi-mirror.domain.tld
MIRROR_SSH_PORT=22
MIRROR_SYNC_KEY=./conf/lsyncd/sync.key
